{
  "name": "@workspace/roblox-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx src/api.ts",
    "dev:bridge": "node --env-file-if-exists=.env --import tsx src/bridge.ts",
    "build": "tsc -p tsconfig.json",
    "plugin:build": "rojo build -o RobloxStudioGameAgent.rbxmx default.project.json",
    "start:api": "node dist/api.js",
    "start:bridge": "node --env-file-if-exists=.env dist/bridge.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
