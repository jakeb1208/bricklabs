# URL of your deployed Railway API service, including https://
AGENT_API_URL=https://your-service.up.railway.app

# Must match the AGENT_API_TOKEN variable configured in Railway.
AGENT_API_TOKEN=replace-with-a-long-random-token

# Roblox Studio plugin talks only to this local port.
BRIDGE_PORT=4317

# Optional: set if your local bridge token should persist across restarts.
# The plugin obtains the token from the loopback-only bridge config endpoint.
# BRIDGE_TOKEN=replace-with-another-long-random-token

# Optional MCP command overrides. Defaults are Roblox's documented Studio paths.
# Windows defaults to cmd.exe /c %LOCALAPPDATA%\Roblox\mcp.bat
# macOS defaults to /Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
# ROBLOX_MCP_COMMAND=
# ROBLOX_MCP_ARGS=[]
